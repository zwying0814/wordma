{% extends "base.tera" %}
{% block content %}
{% if taxonomy %}
<h1 class="page-title">{{ taxonomy.kind }}「{{ taxonomy.name }}」</h1>
{% endif %}
<div class="post-list">
  {% for post in posts %}
  <article class="post-item">
    <h2 class="post-item-title"><a href="{{ post.url }}">{{ post.title }}</a></h2>
    <div class="post-meta">
      {{ post.date }}
      {% for c in post.categories %} · <a href="{{ c.url }}">{{ c.name }}</a>{% endfor %}
      {% for t in post.tags %} · <a href="{{ t.url }}">{{ t.name }}</a>{% endfor %}
      · 约 {{ post.wordCount }} 字
    </div>
  </article>
  {% endfor %}
  {% if posts | length == 0 %}
  <p class="empty">还没有文章。</p>
  {% endif %}
</div>
{% if pagination.total > 1 %}
<nav class="pager">
  {% if pagination.prevUrl %}<a href="{{ pagination.prevUrl }}">← 较新的文章</a>{% endif %}
  <span class="pager-info">{{ pagination.current }} / {{ pagination.total }}</span>
  {% if pagination.nextUrl %}<a href="{{ pagination.nextUrl }}">较早的文章 →</a>{% endif %}
</nav>
{% endif %}
{% endblock %}
