{% extends "base.tera" %}
{% block content %}
<div class="post-list">
  {% for post in posts %}
  <article class="post-item">
    <h2 class="post-item-title"><a href="{{ post.url }}">{{ post.title }}</a></h2>
    <div class="post-meta">
      {{ post.date }}{% if post.categoriesText %} · {{ post.categoriesText }}{% endif %}{% if post.tagsText %} · {{ post.tagsText }}{% endif %} · 约 {{ post.wordCount }} 字
    </div>
  </article>
  {% endfor %}
  {% if posts | length == 0 %}
  <p class="empty">还没有文章。</p>
  {% endif %}
</div>
{% endblock %}
