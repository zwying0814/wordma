{
  "name": "desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build:main": "esbuild electron/src/main.ts --bundle --platform=node --format=esm --external:electron --outfile=electron/main.mjs && esbuild electron/src/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=electron/preload.cjs",
    "dev:electron": "pnpm build:main && VITE_DEV_SERVER_URL=http://localhost:5173 electron electron/main.mjs",
    "build": "tsc -b && vite build && pnpm build:main",
    "e2e": "vite build && pnpm build:main && playwright test",
    "e2e:headed": "vite build && pnpm build:main && playwright test --headed",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@emoji-mart/data": "1.2.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@platejs/basic-nodes": "^53.0.0",
    "@platejs/basic-styles": "^53.0.0",
    "@platejs/code-block": "^53.0.0",
    "@platejs/emoji": "^53.1.7",
    "@platejs/floating": "^53.0.0",
    "@platejs/footnote": "^53.0.0",
    "@platejs/indent": "^53.0.0",
    "@platejs/link": "^53.3.5",
    "@platejs/list": "^53.3.13",
    "@platejs/markdown": "^53.3.15",
    "@platejs/media": "^53.1.4",
    "@platejs/resizable": "^53.0.0",
    "@platejs/table": "^53.0.9",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.55.0",
    "platejs": "^53.3.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.21.4",
    "tailwind-scrollbar-hide": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/ejs": "^3.1.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "ejs": "^7.0.1",
    "electron": "^44.7.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
