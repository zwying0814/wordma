{
  "name": "wordma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "pnpm --filter desktop tauri:dev",
    "dev:web": "pnpm --filter desktop dev",
    "engine": "node scripts/run-bun.mjs packages/engine/src/cli.ts",
    "schema:generate": "node scripts/run-bun.mjs scripts/generate-schemas.ts",
    "schema:validate": "node scripts/run-bun.mjs scripts/validate-schemas.ts",
    "schema:check": "pnpm schema:generate && pnpm schema:validate",
    "test:content": "node scripts/run-bun.mjs test packages/content",
    "test:theme": "node scripts/run-bun.mjs test packages/theme",
    "test:engine": "node scripts/run-bun.mjs test packages/engine",
    "test:create-theme": "node scripts/run-bun.mjs test packages/create-wordma-theme",
    "bench:build": "node scripts/run-bun.mjs scripts/bench-build.ts",
    "test:contracts": "pnpm test:content && pnpm test:theme && pnpm test:engine && pnpm test:create-theme && pnpm fixtures:validate",
    "test:desktop": "pnpm --filter desktop test",
    "test:e2e": "playwright test",
    "test:scripts": "node --test scripts/version.test.mjs",
    "version:check": "node scripts/version.mjs check",
    "version:sync": "node scripts/version.mjs sync",
    "engine:stage": "node scripts/stage-engine.mjs",
    "engine:smoke": "node scripts/smoke-engine-resources.mjs",
    "test:engine-resources": "pnpm engine:stage && pnpm engine:smoke",
    "fixtures:validate": "node scripts/run-bun.mjs scripts/validate-fixtures.ts",
    "build": "pnpm -r --if-present run build",
    "build:app": "pnpm --filter desktop tauri:build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "security:check": "node scripts/security-check.mjs",
    "test": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "check": "pnpm version:check && pnpm security:check && pnpm typecheck && pnpm test:contracts && pnpm test:desktop && pnpm test:e2e && pnpm test:scripts && pnpm test",
    "fetch:bun": "pnpm --filter desktop fetch:bun",
    "lint": "pnpm -r --if-present run lint",
    "format": "pnpm -r --if-present run format",
    "clean": "pnpm -r --if-present run clean"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
